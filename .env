# === For oracle inference and page abstraction ===

# OpenAI client (required, for all baselines)
# 语言模型（用例生成/决策/修复）
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY='YOUR_KEY'
OPENAI_MODEL_NAME="deepseek-v4-flash"

# === For GUI grounding ===
# This is for GUI grounding model, can be local deployment or remote API.

# 视觉模型（截图断言）
GUI_GROUNDING_MODEL_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
GUI_GROUNDING_MODEL_NAME="glm-4.6v"
GUI_GROUNDING_MODEL_API_KEY="YOUR_KEY"

APPLET_USE_REAL_MINIUM=1
# 微信开发者工具
WX_PROJECT_PATH="E:\WebTestPilot\AppletTestPilot\objects\TestApplet"
WX_DEVTOOLS_PATH="D:\微信web开发者工具\cli.bat"
WX_TEST_PORT=24892

# 截图区域 (left,top,width,height) — pyautogui 屏幕截图的裁剪区域
# 仅对微信开发者工具模拟器窗口截图，避免全屏截图过大且包含无关内容
# 如何获取：用截图工具测量模拟器左上角坐标和宽高
# 不设则截全屏（也能正常捕获原生弹窗）
# APPLET_SCREENSHOT_REGION=300,150,400,720