.hero {
  width: 100%;
  height: 520rpx;
  border-radius: 20rpx;
  background: #0F172A;
  margin-bottom: 18rpx;
}

.fav {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(34, 211, 238, 0.14);
  border: 1rpx solid rgba(34, 211, 238, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-icon {
  width: 42rpx;
  height: 42rpx;
}

.desc {
  color: #E2E8F0;
}

.mt {
  margin-top: 18rpx;
}

.s-title {
  font-size: 34rpx;
}

.qty {
  display: flex;
  align-items: center;
  background: #0F172A;
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  border-radius: 18rpx;
  overflow: hidden;
}

.qty-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #F8FAFC;
  font-size: 36rpx;
  background: rgba(124, 58, 237, 0.12);
}

.qty-value {
  width: 88rpx;
  text-align: center;
  font-weight: 700;
  color: #F8FAFC;
}

.comment {
  padding: 16rpx 0;
}

.comment-name {
  font-weight: 700;
  color: #F8FAFC;
}

.comment-time {
  font-size: 24rpx;
}

.comment-content {
  margin-top: 8rpx;
  color: #E2E8F0;
  line-height: 1.6;
}

