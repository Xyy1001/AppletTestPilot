<view class="tap-ripple-overlay" wx:if="{{_tapFx}}">
  <block wx:for="{{_tapFx.sparks}}" wx:key="id">
    <view class="tap-spark"
      style="left: {{_tapFx.x}}px; top: {{_tapFx.y}}px; background: {{item.c}}; animation: sparkFly 0.4s ease-out forwards; animation-delay: {{item.d}}s;"
    ></view>
  </block>
  <view class="tap-ripple-ring"
    style="left: {{_tapFx.x}}px; top: {{_tapFx.y}}px; animation: rippleExpand 0.45s ease-out forwards;"
  ></view>
</view>
<view class="page" wx:if="{{product}}" bindtap="_tap">
  <view class="container">
    <view class="card">
      <image class="hero" src="{{product.images && product.images[0] ? product.images[0] : '/images/cart.jpg'}}" mode="aspectFill"></image>
      <view class="row-between">
        <view class="title">{{product.title}}</view>
        <view class="fav tap" bindtap="onToggleFavorite">
          <image class="fav-icon" src="{{favorites[productId] ? '/images/star_on.png' : '/images/star_off.png'}}" mode="aspectFit"></image>
        </view>
      </view>
      <view class="row-between">
        <view class="price">¥ {{product.price}}</view>
        <view class="chip chip-purple">高对比暗色系</view>
      </view>
      <view class="divider"></view>
      <view class="text desc">{{product.desc}}</view>
    </view>

    <view class="card mt">
      <view class="row-between">
        <view class="title s-title">数量</view>
        <view class="qty">
          <view class="qty-btn tap" bindtap="onMinusQty">-</view>
          <view class="qty-value">{{qty}}</view>
          <view class="qty-btn tap" bindtap="onPlusQty">+</view>
        </view>
      </view>
      <view style="height: 16rpx;"></view>
      <button class="btn btn-primary" bindtap="onAddToCart">加入购物车</button>
    </view>

    <view class="card mt">
      <view class="row-between">
        <view class="title s-title">评论</view>
        <view class="subtitle">{{comments.length}} 条</view>
      </view>
      <view style="height: 16rpx;"></view>
      <input class="input" placeholder="写下你的评价…" value="{{commentText}}" bindinput="onCommentInput" />
      <view style="height: 12rpx;"></view>
      <button class="btn btn-ghost" bindtap="onSubmitComment">发布评论</button>
      <view class="divider"></view>
      <view wx:if="{{comments.length === 0}}" class="subtitle">暂无评论</view>
      <view wx:for="{{comments}}" wx:key="id" class="comment">
        <view class="row-between">
          <view class="comment-name">{{item.userName}}</view>
          <view class="comment-time muted">{{item.createdAtText}}</view>
        </view>
        <view class="comment-content">{{item.content}}</view>
      </view>
    </view>
  </view>
</view>

<view class="page" wx:else bindtap="_tap">
  <view class="container">
    <view class="card">
      <view class="title">商品不存在</view>
      <view class="subtitle">可能已被删除</view>
    </view>
  </view>
</view>
