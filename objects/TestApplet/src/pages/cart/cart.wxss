.item {
  margin-bottom: 18rpx;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  background: #0F172A;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
  line-height: 1.4;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove {
  font-size: 28rpx;
}

.qty {
  display: flex;
  align-items: center;
  background: #0F172A;
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  border-radius: 18rpx;
  overflow: hidden;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #F8FAFC;
  background: rgba(124, 58, 237, 0.14);
}

.qty-value {
  width: 72rpx;
  text-align: center;
  font-weight: 700;
  color: #F8FAFC;
}

.footer {
  position: sticky;
  bottom: 0;
}

