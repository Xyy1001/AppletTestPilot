.field {
  margin-bottom: 18rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #94A3B8;
  margin-bottom: 10rpx;
}

.textarea {
  background: #0F172A;
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  color: #F8FAFC;
  font-size: 28rpx;
  min-height: 220rpx;
  width: 100%;
  box-sizing: border-box;
}

.textarea::placeholder {
  color: rgba(148, 163, 184, 0.7);
}

.add-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.img-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 12rpx;
}

.img-item {
  position: relative;
}

.img {
  width: 100%;
  height: 200rpx;
  border-radius: 18rpx;
  background: #0F172A;
}

.img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(244, 63, 94, 0.9);
  color: #0B0F1A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
}

