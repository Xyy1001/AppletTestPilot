<view class="tap-ripple-overlay" wx:if="{{_tapFx}}">
  <block wx:for="{{_tapFx.sparks}}" wx:key="id">
    <view class="tap-spark"
      style="left: {{_tapFx.x}}px; top: {{_tapFx.y}}px; background: {{item.c}}; animation: sparkFly 0.4s ease-out forwards; animation-delay: {{item.d}}s;"
    ></view>
  </block>
  <view class="tap-ripple-ring"
    style="left: {{_tapFx.x}}px; top: {{_tapFx.y}}px; animation: rippleExpand 0.45s ease-out forwards;"
  ></view>
</view>
<view class="page" bindtap="_tap">
  <view class="container">
    <view class="header card">
      <view class="row-between">
        <view>
          <view class="title">商品展示</view>
          <view class="subtitle">本地数据模式，无需联网</view>
        </view>
        <view class="row">
          <button class="btn btn-ghost header-btn" bindtap="onGoCreateMerchant" wx:if="{{!merchant}}">创建商家</button>
          <button class="btn btn-primary header-btn" bindtap="onGoUpload" wx:if="{{merchant}}">上传产品</button>
        </view>
      </view>
    </view>

    <view class="empty card" wx:if="{{products.length === 0}}">
      <view class="title empty-title">暂无商品</view>
      <view class="subtitle">先在“我的”里创建商家账户并上传产品</view>
      <view style="height: 18rpx;"></view>
      <button class="btn btn-primary" bindtap="onGoCreateMerchant" wx:if="{{!merchant}}">去创建商家</button>
      <button class="btn btn-primary" bindtap="onGoUpload" wx:if="{{merchant}}">去上传产品</button>
    </view>

    <view class="grid-2" wx:if="{{products.length > 0}}">
      <view class="product card tap" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapProduct">
        <image class="cover" src="{{item.images && item.images[0] ? item.images[0] : '/images/cart.jpg'}}" mode="aspectFill"></image>
        <view class="p-title">{{item.title}}</view>
        <view class="row-between">
          <view class="price">¥ {{item.price}}</view>
          <view class="row">
            <view class="icon-btn" catchtap="onToggleFavorite" data-id="{{item.id}}">
              <image class="icon" src="{{favorites[item.id] ? '/images/star_on.png' : '/images/star_off.png'}}" mode="aspectFit"></image>
            </view>
            <view class="icon-btn" catchtap="onAddToCart" data-id="{{item.id}}">
              <image class="icon" src="/images/icon-cart.png" mode="aspectFit"></image>
            </view>
          </view>
        </view>
        <view class="subtitle ellipsis">{{item.desc}}</view>
      </view>
    </view>
  </view>
</view>

