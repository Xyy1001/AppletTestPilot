.header {
  margin-bottom: 18rpx;
}

.header-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border-radius: 18rpx;
  margin-left: 14rpx;
}

.empty {
  padding: 30rpx;
}

.empty-title {
  font-size: 36rpx;
}

.product {
  padding: 16rpx;
}

.cover {
  width: 100%;
  height: 180rpx;
  border-radius: 14rpx;
  background: #0F172A;
  margin-bottom: 10rpx;
}

.p-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 8rpx;
  line-height: 1.35;
  height: 68rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.icon-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 14rpx;
  background: rgba(148, 163, 184, 0.10);
  border: 1rpx solid rgba(148, 163, 184, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.icon {
  width: 30rpx;
  height: 30rpx;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
}

